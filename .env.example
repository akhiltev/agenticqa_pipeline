# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# Requirements / PR connector selection
REQUIREMENTS_SOURCE=mock            # mock | azure_boards | jira
PR_SOURCE=mock                      # mock | azure_repos | github

# Azure DevOps (used by both azure_boards and azure_repos connectors)
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_REPO=

# Iteration bounds
MAX_PLAN_GENERATE_ITERATIONS=3
MAX_GUARDRAIL_RETRIES=2
COVERAGE_TARGET_PCT=80

# Java (only needed if not already on PATH / JAVA_HOME)
JAVA_HOME=
